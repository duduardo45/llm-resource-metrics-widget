#!/usr/bin/env python3
"""Localhost control server for the floating Strata window.

Responsibilities:
  - /mini and /src/... : serve the presentation layer (native ES modules)
  - /metrics           : proxy Strata /metrics with the configured API key
  - /switch            : ask the provider engine to switch normal <-> mini
  - /graph             : persist the selected mini graph index for the bar
  - /status            : pass-through provider status (debug)
  - /health            : readiness marker

Only 127.0.0.1 is bound.
"""
import argparse
import json
import mimetypes
import os
import signal
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.error import HTTPError
from urllib.parse import parse_qs, urlsplit, urlunsplit, urlparse
from urllib.request import Request, urlopen

SCRIPT = ""
PIDFILE = ""
GRAPHFILE = ""
ROOT = None
CONFIG = ""
BUSY = threading.Lock()


class Handler(BaseHTTPRequestHandler):
    server_version = "strata-monitor-ctl/3.0"

    def _send(self, code, body=b"", content_type="text/plain"):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if body:
            self.wfile.write(body)

    def _serve_file(self, path):
        if ROOT is None:
            return self._send(404, b"static root not configured\n")
        try:
            target = path.resolve()
            if target != ROOT and ROOT not in target.parents:
                return self._send(404, b"not found\n")
            if not target.is_file():
                return self._send(404, b"not found\n")
            body = target.read_bytes()
        except OSError:
            return self._send(404, b"not found\n")

        content_type = mimetypes.guess_type(str(target))[0] or "application/octet-stream"
        if target.suffix == ".js":
            content_type = "text/javascript"
        elif target.suffix == ".css":
            content_type = "text/css"
        elif target.suffix == ".html":
            content_type = "text/html"
        return self._send(200, body, content_type)

    def _proxy_metrics(self):
        if not CONFIG:
            return self._send(502, b'{"error":"no config"}\n', "application/json")
        try:
            with open(CONFIG, encoding="utf-8") as fh:
                cfg = json.load(fh)
        except (OSError, ValueError) as exc:
            body = json.dumps({"error": str(exc)}).encode()
            return self._send(502, body, "application/json")

        api_url = cfg.get("url") or "http://ai-brain:8080/#monitor"
        parts = urlsplit(api_url)
        base_path = parts.path or "/"
        if not base_path.endswith("/"):
            base_path += "/"
        metrics_url = urlunsplit(
            (parts.scheme, parts.netloc, base_path + "metrics", "", "")
        )

        request = Request(metrics_url, headers={"Accept": "application/json"})
        api_key = str(cfg.get("apiKey") or "").strip()
        if api_key:
            request.add_header("Authorization", f"Bearer {api_key}")

        try:
            with urlopen(request, timeout=2) as response:
                body = response.read()
                content_type = response.headers.get_content_type() or "application/json"
                return self._send(response.status, body, content_type)
        except HTTPError as exc:
            body = exc.read() if exc.fp else b""
            return self._send(exc.code, body or b"", "application/json")
        except Exception as exc:  # pragma: no cover - defensive
            body = json.dumps({"error": str(exc)}).encode()
            return self._send(502, body, "application/json")

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "*")
        self.end_headers()

    def do_GET(self):
        path = urlparse(self.path).path

        if path == "/health":
            return self._send(200, b"strata-monitor-ctl v3\n")

        if path in ("/mini", "/mini/"):
            return self._serve_file(ROOT / "presentation/mini/index.html") if ROOT else self._send(404)

        if path.startswith("/src/"):
            if ROOT is None:
                return self._send(404)
            return self._serve_file(ROOT / path[len("/src/") :])

        if path == "/metrics":
            return self._proxy_metrics()

        if path == "/graph":
            query = parse_qs(urlparse(self.path).query)
            if "n" in query:
                try:
                    index = int(query["n"][0])
                except ValueError:
                    return self._send(400, b"bad graph index\n")
                if 0 <= index <= 63 and GRAPHFILE:
                    with open(GRAPHFILE, "w", encoding="utf-8") as fh:
                        fh.write(str(index))
                    try:
                        os.chmod(GRAPHFILE, 0o600)
                    except OSError:
                        pass
                return self._send(204)
            value = "0"
            if GRAPHFILE:
                try:
                    with open(GRAPHFILE, encoding="utf-8") as fh:
                        value = fh.read().strip() or "0"
                except OSError:
                    pass
            return self._send(200, (value + "\n").encode())

        if path in ("/switch", "/toggle"):
            if not BUSY.acquire(blocking=False):
                return self._send(202, b"busy\n")

            def run_switch():
                try:
                    subprocess.run(
                        [SCRIPT, "switch"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True,
                    )
                finally:
                    BUSY.release()

            threading.Thread(target=run_switch, daemon=True).start()
            return self._send(202, b"switching\n")

        if path == "/status":
            try:
                result = subprocess.run(
                    [SCRIPT, "status"], capture_output=True, text=True, timeout=5
                )
                body = result.stdout or json.dumps({"text": "", "tooltip": "", "class": ""})
            except Exception as exc:  # pragma: no cover - defensive
                body = json.dumps({"text": "", "tooltip": str(exc), "class": ""})
            return self._send(200, body.encode(), "application/json")

        return self._send(404, b"not found\n")

    def log_message(self, fmt, *args):
        return


def main():
    global SCRIPT, PIDFILE, GRAPHFILE, ROOT, CONFIG
    parser = argparse.ArgumentParser()
    parser.add_argument("--port", type=int, default=8787)
    parser.add_argument("--script", required=True)
    parser.add_argument("--pidfile", default="")
    parser.add_argument("--graphfile", default="")
    parser.add_argument("--root", default="")
    parser.add_argument("--config", default="")
    args = parser.parse_args()

    SCRIPT = args.script
    PIDFILE = args.pidfile
    GRAPHFILE = args.graphfile
    ROOT = Path(args.root).resolve() if args.root else None
    CONFIG = args.config

    if PIDFILE:
        with open(PIDFILE, "w", encoding="utf-8") as fh:
            fh.write(str(os.getpid()))
        os.chmod(PIDFILE, 0o600)

    def stop(_signum, _frame):
        if PIDFILE:
            try:
                os.unlink(PIDFILE)
            except OSError:
                pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    server.daemon_threads = True
    print(f"strata-monitor-ctl listening on 127.0.0.1:{args.port}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
