#!/usr/bin/env python3
"""Tiny localhost control server for the floating Strata window.

The web page cannot run a shell command, so it asks this server to switch
between the normal and mini layouts. It only listens on 127.0.0.1 and only
starts when a floating window is launched.
"""
import argparse
import json
import os
import signal
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

SCRIPT = ""
PIDFILE = ""
GRAPHFILE = ""
BUSY = threading.Lock()


class Handler(BaseHTTPRequestHandler):
    server_version = "strata-monitor-ctl/1.0"

    def _send(self, code, body=b"", content_type="text/plain"):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if body:
            self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "*")
        self.end_headers()

    def do_GET(self):
        path = urlparse(self.path).path

        if path == "/health":
            return self._send(200, b"strata-monitor-ctl v2\n")

        if path == "/graph":
            query = parse_qs(urlparse(self.path).query)
            if "n" in query:
                try:
                    index = int(query["n"][0])
                except ValueError:
                    return self._send(400, b"bad graph index\n")
                if 0 <= index <= 63 and GRAPHFILE:
                    with open(GRAPHFILE, "w", encoding="utf-8") as fh:
                        fh.write(str(index))
                    try:
                        os.chmod(GRAPHFILE, 0o600)
                    except OSError:
                        pass
                return self._send(204)
            value = "0"
            if GRAPHFILE:
                try:
                    with open(GRAPHFILE, encoding="utf-8") as fh:
                        value = fh.read().strip() or "0"
                except OSError:
                    pass
            return self._send(200, (value + "\n").encode())

        if path in ("/switch", "/toggle"):
            if not BUSY.acquire(blocking=False):
                return self._send(202, b"busy\n")

            def run_switch():
                try:
                    subprocess.run(
                        [SCRIPT, "switch"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True,
                    )
                finally:
                    BUSY.release()

            threading.Thread(target=run_switch, daemon=True).start()
            return self._send(202, b"switching\n")

        if path == "/status":
            try:
                result = subprocess.run(
                    [SCRIPT, "status"], capture_output=True, text=True, timeout=5
                )
                body = result.stdout or json.dumps({"text": "", "tooltip": "", "class": ""})
            except Exception as exc:  # pragma: no cover - defensive
                body = json.dumps({"text": "", "tooltip": str(exc), "class": ""})
            return self._send(200, body.encode(), "application/json")

        return self._send(404, b"not found\n")

    def log_message(self, fmt, *args):
        return


def main():
    global SCRIPT, PIDFILE, GRAPHFILE
    parser = argparse.ArgumentParser()
    parser.add_argument("--port", type=int, default=8787)
    parser.add_argument("--script", required=True)
    parser.add_argument("--pidfile", default="")
    parser.add_argument("--graphfile", default="")
    args = parser.parse_args()

    SCRIPT = args.script
    PIDFILE = args.pidfile
    GRAPHFILE = args.graphfile
    if PIDFILE:
        with open(PIDFILE, "w", encoding="utf-8") as fh:
            fh.write(str(os.getpid()))
        os.chmod(PIDFILE, 0o600)

    def stop(_signum, _frame):
        if PIDFILE:
            try:
                os.unlink(PIDFILE)
            except OSError:
                pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    server.daemon_threads = True
    print(f"strata-monitor-ctl listening on 127.0.0.1:{args.port}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
